{
  // zensical
  "files.associations": {
    "*.md": "python-markdown",
  },
  "[python-markdown]": {
    "editor.defaultFormatter": "zensical.zensical-studio",
    "editor.formatOnSave": true,
  },
  // cspell
  "cSpell.enabled": true,
  "cSpell.enabledFileTypes": {
    "*": false,
    "markdown": true,
    "python-markdown": true,
  }
}
